{
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.7.1"
        },
        "api/index.php": {
            "runtime": "vercel-php@0.7.1"
        }
    },
    "routes": [
        {
            "src": "/certs/(.*)",
            "status": 404
        },
        {
            "src": "/(css|js|images|assets)/(.*)",
            "dest": "/$1/$2"
        },
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/ajax/(.*)",
            "dest": "/api/ajax-proxy.php?route=$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}